# PartyKit server host for multiplayer mode
# In development, defaults to localhost:1999
# In production, set this to your PartyKit deployment URL (e.g. mot-aleatoire.YOUR_USERNAME.partykit.dev)
VITE_PARTYKIT_HOST=localhost:1999

# Admin token used by PartyKit leaderboard endpoints:
#   /parties/leaderboard/global/admin/export
#   /parties/leaderboard/global/admin/restore
#   /parties/leaderboard/global/admin/clear
# Note: set this on PartyKit deployment (e.g. `partykit env add LEADERBOARD_ADMIN_TOKEN`).
LEADERBOARD_ADMIN_TOKEN=change-me
